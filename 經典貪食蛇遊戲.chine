// 意圖編譯生成：做一個貪食蛇遊戲
// 經典貪食蛇遊戲

設 畫布寬度 = 400;
設 畫布高度 = 400;
設 網格大小 = 20;
設 分數 = 0;
設 遊戲結束 = 假;

設 蛇身 = [
  { x: 160, y: 200 },
  { x: 140, y: 200 },
  { x: 120, y: 200 }
];

設 食物 = { x: 240, y: 200 };
設 移動方向 = "右"; // 上、下、左、右

印出("🎮 貪食蛇遊戲已由意圖編譯器生成完畢！");
印出("操作說明：使用鍵盤方向鍵 ↑ ↓ ← → 控制蛇身移動。");

函式 產生新食物() {
  食物.x = 算術.整數隨機數(0, 19) * 網格大小;
  食物.y = 算術.整數隨機數(0, 19) * 網格大小;
}

函式 遊戲每幀更新() {
  若 (遊戲結束 == 真) { 回傳; }

  // 計算蛇頭新位置
  設 蛇頭 = { x: 蛇身[0].x, y: 蛇身[0].y };
  若 (移動方向 == "右") { 蛇頭.x += 網格大小; }
  否則若 (移動方向 == "左") { 蛇頭.x -= 網格大小; }
  否則若 (移動方向 == "上") { 蛇頭.y -= 網格大小; }
  否則若 (移動方向 == "下") { 蛇頭.y += 網格大小; }

  // 撞牆判斷
  若 (蛇頭.x < 0 || 蛇頭.x >= 畫布寬度 || 蛇頭.y < 0 || 蛇頭.y >= 畫布高度) {
    遊戲結束 = 真;
    印出("💥 遊戲結束！最終得分：", 分數);
    回傳;
  }

  陣列.推入(蛇身, 蛇頭); // 蛇頭前進

  // 吃到食物判斷
  若 (蛇頭.x == 食物.x && 蛇頭.y == 食物.y) {
    分數 += 10;
    印出("🍎 吃到蘋果！當前得分：", 分數);
    產生新食物();
  } 否則 {
    陣列.彈出(蛇身); // 尾部收縮
  }
}
