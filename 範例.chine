// 華語獨立高階語言範例檔 (.chine)
設 語言 = "華語 (HuaLang)";
設 副檔名 = ".chine";

印出("歡迎使用獨立高階語言：" + 語言 + "，專屬副檔名：" + 副檔名);

設 質數計數 = 0;
從 2 到 20 循環 (數字) {
  設 是質數 = 真;
  從 2 到 (數字 - 1) 循環 (因數) {
    若 (數字 % 因數 == 0) {
      是質數 = 假;
    }
  }
  若 (是質數 == 真) {
    印出("發現質數：", 數字);
    質數計數 = 質數計數 + 1;
  }
}

印出("2 到 20 之間的質數共有：", 質數計數, "個！");
