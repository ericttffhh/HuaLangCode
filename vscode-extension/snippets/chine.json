{
  "宣告變數": {
    "prefix": "設",
    "body": [
      "設 ${1:變數名稱} = ${2:數值};$0"
    ],
    "description": "宣告一個新的變數"
  },
  "宣告常數": {
    "prefix": "常數",
    "body": [
      "常數 ${1:常數名稱} = ${2:數值};$0"
    ],
    "description": "宣告一個唯讀常數"
  },
  "條件判斷": {
    "prefix": "若",
    "body": [
      "若 (${1:條件}) {",
      "  $0",
      "} 否則 {",
      "  ",
      "}"
    ],
    "description": "若 / 否則 條件判斷式"
  },
  "範圍循環": {
    "prefix": "從",
    "body": [
      "從 ${1:1} 到 ${2:10} 循環 (${3:計數}) {",
      "  $0",
      "}"
    ],
    "description": "從 ... 到 ... 計數循環"
  },
  "當型循環": {
    "prefix": "當",
    "body": [
      "當 (${1:條件}) {",
      "  $0",
      "}"
    ],
    "description": "當型 While 循環"
  },
  "遍歷陣列": {
    "prefix": "遍歷",
    "body": [
      "遍歷 ${1:陣列} 於 ${2:項目} {",
      "  $0",
      "}"
    ],
    "description": "遍歷陣列元素 (ForEach)"
  },
  "自訂函式": {
    "prefix": "函式",
    "body": [
      "函式 ${1:函式名}(${2:參數}) {",
      "  $0",
      "  回傳 ${3:數值};",
      "}"
    ],
    "description": "定義自訂函式"
  },
  "印出輸出": {
    "prefix": "印出",
    "body": [
      "印出(${1:\"內容\"});$0"
    ],
    "description": "在終端機輸出訊息"
  },
  "海龜繪圖模板": {
    "prefix": "海龜",
    "body": [
      "海龜.重設();",
      "海龜.設顏色(\"${1:翡翠}\");",
      "海龜.設筆寬(${2:2});",
      "從 1 到 ${3:36} 循環 (i) {",
      "  海龜.前進(${4:100});",
      "  海龜.右轉(${5:170});",
      "}$0"
    ],
    "description": "海龜繪圖模板"
  }
}
